@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h1 class="h3 mb-0">Импорт товаров из CSV</h1>
    </div>
    <div class="card-body">
        <form method="post" asp-controller="Products" asp-action="Import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="filePath">Путь к CSV-файлу</label>
                <input type="text"
                       id="filePath"
                       name="filePath"
                       class="form-control"
                       value="@Model.FilePath"
                       placeholder="/csv/sample_products.csv" />
                <small class="text-muted">Введите путь к файлу, например /csv/sample_products.csv</small>
            </div>

            <hr />
            <p class="text-muted">Или выберите файл с компьютера</p>

            <div class="form-group">
                <input type="file" name="file" accept=".csv" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 mt-3">Импортировать товары</button>
        </form>
    </div>
</div>

@if (Model.Result != null)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Результат импорта</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover mt-3">
                <thead>
                    <tr>
                        <th>Показатель</th>
                        <th>Значение</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Всего строк</td>
                        <td>@Model.Result.TotalRows</td>
                    </tr>
                    <tr>
                        <td>Успешно импортировано</td>
                        <td>@Model.Result.ImportedCount</td>
                    </tr>
                    <tr>
                        <td>Ошибки</td>
                        <td>@Model.Result.ErrorCount</td>
                    </tr>
                </tbody>
            </table>

            @if (Model.Result.Errors.Count > 0)
            {
                <h5>Список ошибок</h5>

                <table class="table table-striped table-hover mt-3">
                    <thead>
                        <tr>
                            <th>Строка</th>
                            <th>Описание ошибки</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Model.Result.Errors)
                        {
                            <tr>
                                <td>@error.RowNumber</td>
                                <td>@error.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <a asp-action="Index" class="btn btn-success">Перейти к списку товаров</a>
        </div>
    </div>
}
