@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Список товаров";

    var priceSort = Model.SortOrder == "price_asc" ? "price_desc" : "price_asc";
    var stockSort = Model.SortOrder == "stock_asc" ? "stock_desc" : "stock_asc";
    var priceArrow = Model.SortOrder == "price_asc" ? "▲" : Model.SortOrder == "price_desc" ? "▼" : "";
    var stockArrow = Model.SortOrder == "stock_asc" ? "▲" : Model.SortOrder == "stock_desc" ? "▼" : "";
}

<h1 class="display-5 mb-4">Товары</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex gap-4 mb-3">
            <p class="h5 mb-0">Всего товаров: @Model.AllProductsCount</p>
            <p class="h5 mb-0">Общая стоимость: @Model.AllProductsTotalValue.ToString("N0") RUB</p>
            @if (!string.IsNullOrWhiteSpace(Model.SearchString) || !string.IsNullOrWhiteSpace(Model.CategoryFilter))
            {
                <p class="h5 mb-0 text-muted">Найдено: @Model.TotalCount на сумму @Model.TotalValue.ToString("N0") RUB</p>
            }
        </div>

        <form method="get" asp-action="Index" class="d-flex gap-2 mb-3">
            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
            <input type="text" name="searchString" value="@Model.SearchString" placeholder="Поиск по названию" class="form-control" />
            <select name="categoryFilter" class="form-select">
                <option value="">Все категории</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@string.Equals(category, Model.CategoryFilter, StringComparison.OrdinalIgnoreCase)">@category</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Найти</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            <a asp-action="Export" class="btn btn-outline-success ms-auto">Экспорт в CSV</a>
        </form>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-info mb-0">
                @(Model.Categories.Count == 0 ? "Товары еще не импортированы." : "По вашему запросу ничего не найдено.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Артикул</th>
                            <th>Название</th>
                            <th>Описание</th>
                            <th><a class="text-white text-decoration-none" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-categoryFilter="@Model.CategoryFilter" asp-route-sortOrder="@priceSort">Цена @priceArrow</a></th>
                            <th>Валюта</th>
                            <th>Категория</th>
                            <th><a class="text-white text-decoration-none" asp-action="Index" asp-route-searchString="@Model.SearchString" asp-route-categoryFilter="@Model.CategoryFilter" asp-route-sortOrder="@stockSort">Остаток @stockArrow</a></th>
                            <th>Активен</th>
                            <th>Бренд</th>
                            <th>Гарантия, мес.</th>
                            <th>Модель</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-sku="@product.Sku">@product.Sku</a></td>
                                <td>@product.Name</td>
                                <td>@product.Description</td>
                                <td>@product.Price.ToString("N0")</td>
                                <td>@product.Currency</td>
                                <td>@product.CategoryName</td>
                                <td>@product.StockQuantity</td>
                                <td>@(product.IsActive ? "Да" : "Нет")</td>
                                <td>@product.Brand</td>
                                <td>@product.WarrantyMonths</td>
                                <td>@product.ModelNumber</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<a asp-action="Import" class="btn btn-primary mt-3">Импортировать товары</a>
