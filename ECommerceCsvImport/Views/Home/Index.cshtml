@{
    ViewData["Title"] = "Главная";
}

<div class="text-center my-5">
    <h1 class="display-4">Добро пожаловать</h1>
    <p class="lead">Модуль импорта товаров электроники из CSV-файлов в магазин. Данные хранятся в памяти приложения.</p>
    <a class="btn btn-primary btn-lg me-2" asp-controller="Products" asp-action="Import">Перейти к импорту</a>
    <a class="btn btn-outline-secondary btn-lg" asp-controller="Products" asp-action="Index">Список товаров</a>
</div>
